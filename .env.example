# Azure DevOps (lido no servidor; o PAT vem do POST /api/jobs e não é persistido)
# ADO_API_VERSION=7.1
# ACCEPTANCE_CRITERIA_FIELD=Microsoft.VSTS.Common.AcceptanceCriteria
# ALLOWED_WORK_ITEM_TYPES=User Story,Epic,História de Usuário,Épica

# Limites
# MAX_ATTACHMENT_BYTES=15728640
# MAX_TOTAL_ATTACHMENT_BYTES=41943040
# MAX_LLM_OUTPUT_CHARS=48000
# JOB_PAT_TTL_MS=1800000
# JOB_RESULT_TTL_MS=1800000

# LLM (opcional — sem chave, o relatório usa só template determinístico)
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# WebSocket (processo ws-server) — ponte interna Next -> WS
WS_PORT=3001
JOB_INTERNAL_SECRET=change-me-in-production
WS_INTERNAL_BASE_URL=http://127.0.0.1:3001

# Browser (URL pública do WS; se vazio, o client tenta hostname atual na porta WS_PORT)
# NEXT_PUBLIC_WS_URL=ws://127.0.0.1:3001
